<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static twin of SplashView: paper background, wordmark pinned to safe-area
  top + 14 (SignuWordmark.topPadding) and centred horizontally, so launch
  image → SplashView → 16a keeps the mark in one fixed position throughout.

  The wordmark is a rendered image, not storyboard views: ibtool rejects
  user-defined runtime attributes in launch screens, which is exactly what the
  tile's `layer.cornerRadius` would need. Tools/generate-wordmark-asset.sh
  renders it from the real SignuWordmark — re-run it if that view changes, and
  update the size constraints below if the printed size changes.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Launch Screen-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Wordmark" translatesAutoresizingMaskIntoConstraints="NO" id="wMk-2n-Rp8" userLabel="Wordmark">
                                <rect key="frame" x="151.5" y="73" width="90" height="111"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="6Tk-OE-BBY"/>
                        <color key="backgroundColor" red="0.93725490196078431" green="0.92941176470588238" blue="0.90196078431372551" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="wMk-2n-Rp8" firstAttribute="top" secondItem="6Tk-OE-BBY" secondAttribute="top" constant="14" id="rc1-aa-101"/>
                            <constraint firstItem="wMk-2n-Rp8" firstAttribute="centerX" secondItem="6Tk-OE-BBY" secondAttribute="centerX" id="rc2-aa-102"/>
                            <constraint firstItem="wMk-2n-Rp8" firstAttribute="width" secondItem="Ze5-6b-2t3" secondAttribute="width" multiplier="0.0" constant="90" id="rc3-aa-103"/>
                            <constraint firstItem="wMk-2n-Rp8" firstAttribute="height" secondItem="Ze5-6b-2t3" secondAttribute="height" multiplier="0.0" constant="111" id="rc4-aa-104"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="Wordmark" width="90" height="111"/>
    </resources>
</document>
